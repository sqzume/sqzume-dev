---
import type { CollectionEntry } from "astro:content";
import { formatDate, isoDate } from "../lib/format";
import PostTags from "./PostTags.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { title, pubDate, tags, draft } = post.data;
---

<!-- 一覧に縦に積む記事の行。タイトル・タグ・日付を 1 行にまとめる。
     面の色では区切らず、タイトルの下線と、タイトルから右端へ引く線で 1 行ずつ独立させる。
     長いタイトルは 1 行で切る。全文は記事ページで読める。 -->
<li class="row">
  <h2>
    <a href={`/blog/${post.id}/`}>{title}</a>
  </h2>
  {draft && <span class="draft">Draft</span>}
  <span class="leader" aria-hidden="true"></span>
  <div class="tags">
    <PostTags tags={tags} />
  </div>
  <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
</li>

<style>
  /* 行全体を押せる対象にしつつ、中のタグも個別のリンクにする。
     リンクの入れ子はできないので、タイトルのリンクを ::after で行全体に広げ、
     タグだけをその上に持ち上げる（PostTags 側で持ち上げている）。 */
  .row {
    position: relative;
    /* グリッドに並べたとき、1 行に固定したタイトルの長さで行が伸びないようにする */
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.45rem 0.6rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    transition:
      background-color var(--speed) var(--ease),
      border-color var(--speed) var(--ease);
  }

  /* 即応 UI: 触れた瞬間にアクセント色の枠で囲み、内側を薄く塗る */
  .row:hover {
    border-color: color-mix(in oklch, var(--accent) 45%, transparent);
    background: color-mix(in oklch, var(--accent) 6%, transparent);
  }

  /* タイトルは自分の長さだけ幅を取り、余りを右へ引く線に回す。
     入りきらないときはタイトルのほうを縮めて「…」で切る */
  h2 {
    flex: 0 1 auto;
    min-width: 0;
    font-size: 0.9rem;
    line-height: 1.8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  h2 a {
    color: var(--text-strong);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--accent) 30%, transparent);
    text-underline-offset: 0.3em;
    transition:
      color var(--speed) var(--ease),
      text-decoration-color var(--speed) var(--ease);
  }

  h2 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .row:hover h2 a {
    color: var(--accent);
    text-decoration-color: color-mix(in oklch, var(--accent) 80%, transparent);
  }

  h2 a:focus-visible {
    outline: none;
  }

  .row:has(h2 a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .draft {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--accent);
    background: var(--accent-surface);
    border-radius: var(--radius);
    padding: 0.1rem 0.45rem;
  }

  /* タイトルから右端のタグへ引く線。触れている間は枠があるので消す */
  .leader {
    flex: 1 1 0;
    min-width: 1rem;
    height: 1px;
    background: color-mix(in oklch, var(--border) 70%, transparent);
    transition: opacity var(--speed) var(--ease);
  }

  .row:hover .leader {
    opacity: 0;
  }

  .tags {
    flex-shrink: 0;
    max-width: 40%;
  }

  time {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.6;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /* 狭い画面ではタイトルの幅を優先し、タグは記事ページに任せる */
  @media (max-width: 40rem) {
    .tags {
      display: none;
    }
  }
</style>
