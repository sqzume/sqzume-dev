---
const year = new Date().getFullYear();
---

<footer>
  <div class="inner">
    <span>&copy; {year} sqzume</span>
    <a href="https://github.com/sqzume" rel="me noopener">
      GitHub
    </a>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: auto;
  }

  .inner {
    max-width: var(--page);
    margin-inline: auto;
    padding: 1.5rem;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  a {
    color: var(--text-muted);
    text-decoration: none;
    transition: color var(--speed) var(--ease);
  }

  a:hover {
    color: var(--accent);
  }
</style>
