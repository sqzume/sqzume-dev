---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts } from "../../lib/posts";
import { formatDate, isoDate } from "../../lib/format";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// 目次は h2 と h3 のみ。h4 まで拾うと目次が本文より長くなる
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
>
  <article>
    <header class="head">
      <h1>{post.data.title}</h1>
      <div class="meta">
        <span>
          Published:{" "}
          <time datetime={isoDate(post.data.pubDate)}>
            {formatDate(post.data.pubDate)}
          </time>
        </span>
        {post.data.updatedDate && (
          <>
            <span aria-hidden="true">/</span>
            <span>
              Updated:{" "}
              <time datetime={isoDate(post.data.updatedDate)}>
                {formatDate(post.data.updatedDate)}
              </time>
            </span>
          </>
        )}
        {post.data.draft && <span class="draft">下書き</span>}
      </div>
    </header>

    <div class="grid">
      <div class="prose">
        <Content />
      </div>

      {(toc.length > 1 || post.data.tags.length > 0) && (
        <aside class="side">
          {toc.length > 1 && (
            <nav class="box toc" aria-label="目次">
              <p class="box-title">目次</p>
              <ul>
                {toc.map((h) => (
                  <li class={h.depth === 3 ? "nested" : undefined}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          )}
          {post.data.tags.length > 0 && (
            <div class="box">
              <p class="box-title">タグ</p>
              <ul class="tags">
                {post.data.tags.map((tag) => (
                  <li>
                    <a href={`/tags/${tag}/`}>{tag}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </aside>
      )}
    </div>

    <footer class="foot">
      <a href="/blog/" class="back">
        &larr; 記事一覧へ
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  /* ── 記事ヘッダー ───────────────────────────── */
  .head {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  /* 広い画面では、タイトル・本文・目次をヘッダーの左右から一段内側に入れる。
     区切り線は内側に入れず、ページ幅いっぱいに引く */
  @media (min-width: 60rem) {
    .head,
    .grid,
    .foot {
      padding-inline: 2.5rem;
    }
  }

  .meta {
    margin-top: 0.75rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .draft {
    color: var(--accent);
    border: 1px solid var(--accent-surface);
    background: var(--accent-surface);
    border-radius: var(--radius);
    padding: 0.1rem 0.45rem;
  }

  .head h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    max-width: var(--measure);
  }

  /* 広い画面ではタイトルを本文の行長に縛らず、1 行で読めるようにする */
  @media (min-width: 60rem) {
    .head h1 {
      max-width: none;
    }
  }

  /* ── 本文と目次の配置 ───────────────────────── */
  .grid {
    margin-top: 2.5rem;
  }

  /* 目次はページの右端に固定し、残りの幅をすべて本文に回す。
     本文の行長は画面幅に合わせて伸び縮みする */
  @media (min-width: 60rem) {
    .grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 14rem;
      gap: 3rem;
      align-items: start;
    }
  }

  /* ── 目次とタグ ───────────────────────────────
     本文の右（狭い画面では本文の下）に目次とタグを縦に積む */
  .side {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
  }

  /* 広い画面では本文の右に置き、読み進めても付いてくるようにする */
  @media (min-width: 60rem) {
    .side {
      position: sticky;
      top: 5rem;
      margin-top: 0;
    }
  }

  /* 左の縦線を上端で「┌」の形に曲げ、その先に見出しを載せる */
  .box {
    --box-title-height: 1.5rem;
    position: relative;
    padding-left: 1rem;
  }

  .box::before {
    content: "";
    position: absolute;
    top: calc(var(--box-title-height) / 2);
    bottom: 0;
    left: 0;
    width: 0.6rem;
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
    border-top-left-radius: var(--radius);
  }

  .box-title {
    margin-left: -0.2rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: var(--box-title-height);
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .toc ul {
    margin-top: 0.5rem;
    display: grid;
    gap: 0.35rem;
  }

  .toc li.nested {
    padding-left: 0.9rem;
  }

  /* 押せることが分かるよう、白い文字に薄いアクセント色の下線を引く */
  .toc a {
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--text-strong);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--accent) 30%, transparent);
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--speed) var(--ease);
  }

  .toc a:hover {
    text-decoration-color: color-mix(in oklch, var(--accent) 80%, transparent);
  }

  .tags {
    margin-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tags a {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.6;
    color: var(--text-muted);
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.05rem 0.5rem;
    transition:
      color var(--speed) var(--ease),
      border-color var(--speed) var(--ease),
      background-color var(--speed) var(--ease);
  }

  .tags a:hover {
    color: var(--accent);
    border-color: var(--accent-surface);
    background: var(--accent-surface);
  }

  /* ── 本文の組版 ─────────────────────────────
     和文の可読性がこのサイトの品質のほぼ全て。
     行長は --measure、行間は 1.9 を基準にする。 */
  .prose {
    max-width: var(--measure);
    font-size: 1rem;
  }

  /* 広い画面では目次の手前まで本文を広げる */
  @media (min-width: 60rem) {
    .prose {
      max-width: none;
    }
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(pre),
  .prose :global(blockquote) {
    margin-top: 1.5rem;
  }

  .prose :global(h2) {
    font-size: 1.4rem;
    margin-top: 3rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }

  .prose :global(h3) {
    font-size: 1.15rem;
    margin-top: 2.2rem;
  }

  .prose :global(strong) {
    color: var(--text-strong);
    font-weight: 700;
  }

  /* 本文のリンクは白い文字に薄いアクセント色の下線で示し、
     触れたときだけ文字もアクセント色にする。本文中で色が強く出すぎないように */
  .prose :global(a) {
    color: var(--text-strong);
  }

  .prose :global(a:hover) {
    color: var(--accent);
  }

  .prose :global(ul) {
    list-style: none;
    display: grid;
    gap: 0.5rem;
  }

  .prose :global(ul li) {
    position: relative;
    padding-left: 1.2rem;
  }

  /* 箇条書きの点にもアクセントを使い、画面全体の色数を増やさない */
  .prose :global(ul li)::before {
    content: "";
    position: absolute;
    left: 0.15rem;
    top: 0.85em;
    width: 0.3rem;
    height: 1px;
    background: var(--accent-dim);
  }

  .prose :global(ol) {
    list-style: decimal;
    padding-left: 1.4rem;
    display: grid;
    gap: 0.5rem;
  }

  .prose :global(blockquote) {
    border-left: 2px solid var(--border-strong);
    padding-left: 1.2rem;
    color: var(--text-muted);
  }

  /* ── 記事フッター ───────────────────────────── */
  .foot {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .back {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-decoration: none;
    color: var(--text-muted);
    transition: color var(--speed) var(--ease);
  }

  .back:hover {
    color: var(--accent);
  }
</style>
